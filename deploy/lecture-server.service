# Ubuntu 서버에서 jar 를 "서비스"로 등록하는 파일 (systemd)
# 설치: sudo cp lecture-server.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now lecture-server
# 확인: sudo systemctl status lecture-server
# 로그: journalctl -u lecture-server -f

[Unit]
Description=Cheongyak lecture server (Spring Boot)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/lecture-server
EnvironmentFile=/opt/lecture-server/app.env
ExecStart=/usr/bin/java -jar /opt/lecture-server/lecture-server.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
